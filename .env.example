# ============================================================
# Variables de entorno — Negocio Katering Backend (API v1)
# ============================================================
# Copiar este archivo a .env y reemplazar con los valores reales.
# NUNCA subir el archivo .env al repositorio ni exponer secretos.
# ============================================================

# Entorno: development | production | test
NODE_ENV=development

# Puerto HTTP del servidor Express (Render asigna process.env.PORT automáticamente)
PORT=3000

# PostgreSQL connection string
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Desarrollo local:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/negocio_db

# Supabase PostgreSQL (Producción / Staging):
# Usar la URL de Transaction Pooler (Puerto 6543) o Session Pooler (Puerto 5432)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# JWT — Secretos para firmar tokens de acceso y actualización (mínimo 32 caracteres)
# Generar claves aleatorias seguras con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev_jwt_access_secret_must_be_at_least_32_chars_long
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_must_be_at_least_32_chars_long

# Expiración de tokens JWT (formato ms, s, m, h, d — librería jsonwebtoken)
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=30d

# CORS — Origin permitido (URL del cliente Flutter Web / App)
# En desarrollo: * o http://localhost:3000
# En producción: https://tu-dominio-flutter.web.app (NUNCA '*' en producción)
CORS_ORIGIN=*
