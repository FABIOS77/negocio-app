# ============================================================
# Variables de entorno — Negocio Katering Backend
# ============================================================
# Copiar este archivo a .env y completar los valores reales.
# NUNCA subir .env al repositorio.
# ============================================================

# Entorno: development | production | test
NODE_ENV=development

# Puerto HTTP del servidor
PORT=3000

# PostgreSQL connection string
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Supabase: usar la connection string del panel de Supabase (Transaction Pooler)
DATABASE_URL=postgresql://postgres:password@localhost:5432/negocio_db

# JWT — Secretos para firmar tokens (mínimo 32 caracteres, aleatorios y seguros)
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_use_a_random_secret_of_at_least_32_characters
JWT_REFRESH_SECRET=change_me_use_a_different_random_secret_of_at_least_32_chars

# Duración de tokens (formato: ms, s, m, h, d — librería jsonwebtoken)
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=30d

# CORS — origin permitido (URL de la app Flutter / cliente)
# En producción usar la URL exacta, no '*'
CORS_ORIGIN=*
